<Application x:Class="LarpStrap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 is replaced at runtime by ThemeService (light/dark). -->
        <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <views:EqualsConverter x:Key="Equals" />
      <views:BoolToVisibilityConverter x:Key="Visible" />
      <views:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
