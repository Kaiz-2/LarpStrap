<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Interface themes (Personalización): each one replaces only the surfaces of Colors.Dark/Light.xaml; text, borders
    and state colours stay there. ThemeService reads Preset{Theme}{Dark|Light}{Role}Brush; ThemeContrastTests checks
    every theme against the text, border and state colours of its mode.
  -->
  <!-- Nebula -->
  <SolidColorBrush x:Key="PresetNebulaDarkBgBrush" Color="#111318" />
  <SolidColorBrush x:Key="PresetNebulaDarkSurfaceBrush" Color="#181B22" />
  <SolidColorBrush x:Key="PresetNebulaDarkSurfaceAltBrush" Color="#20242C" />
  <SolidColorBrush x:Key="PresetNebulaDarkSurfaceHoverBrush" Color="#292E38" />
  <SolidColorBrush x:Key="PresetNebulaDarkBorderSubtleBrush" Color="#303743" />
  <SolidColorBrush x:Key="PresetNebulaLightBgBrush" Color="#F3F4F6" />
  <SolidColorBrush x:Key="PresetNebulaLightSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PresetNebulaLightSurfaceAltBrush" Color="#EEF0F3" />
  <SolidColorBrush x:Key="PresetNebulaLightSurfaceHoverBrush" Color="#E4E7EB" />
  <SolidColorBrush x:Key="PresetNebulaLightBorderSubtleBrush" Color="#D7DCE3" />
