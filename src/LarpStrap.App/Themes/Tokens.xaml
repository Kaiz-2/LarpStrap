<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Nebulosa design tokens (docs/brand-guidelines.md). Windows system fonts only, so nothing is downloaded or bundled:
    Bahnschrift gives headings and the wordmark their technical, gaming feel; Segoe UI Variable keeps body text legible.
    Spacing uses multiples of 4.
  -->
  <FontFamily x:Key="FontBrand">Bahnschrift SemiBold, Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
  <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="FontSizeCaption">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">14</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
  <sys:Double x:Key="FontSizeTitle">20</sys:Double>
  <sys:Double x:Key="FontSizeDisplay">28</sys:Double>
  <sys:Double x:Key="FontSizeHero">40</sys:Double>

  <!-- Fluent-like radii: small on controls, a step up on cards, the largest only on the brand hero. -->
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusContainer">8</CornerRadius>
  <CornerRadius x:Key="RadiusHero">12</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusStatus">4</CornerRadius>

  <!-- Navigation pane: expanded with labels, or compact (icons with tooltips). Session only. -->
  <sys:Double x:Key="NavWidth">264</sys:Double>
  <sys:Double x:Key="NavWidthCompact">72</sys:Double>
  <!-- Compact list rows (clients, games). -->
  <sys:Double x:Key="RowHeight">52</sys:Double>

  <sys:Double x:Key="ControlHeight">42</sys:Double>
  <sys:Double x:Key="ControlHeightLarge">50</sys:Double>

  <!-- Logo: a launch glyph (an L holding a play mark) on the brand tile, drawn in a 64×64 box. -->
  <Geometry x:Key="LogoTile">M14,0 H50 A14,14 0 0 1 64,14 V50 A14,14 0 0 1 50,64 H14 A14,14 0 0 1 0,50 V14 A14,14 0 0 1 14,0 Z</Geometry>
  <!-- v2: a rounded L whose corner holds a rounded play mark; the tile gets a soft top gloss (LogoGloss). -->
  <Geometry x:Key="LogoMark">M18,17 Q18,14 21,14 H24 Q27,14 27,17 V41 H41 Q44,41 44,44 V47 Q44,50 41,50 H21 Q18,50 18,47 Z M35.65,19.4 L47.35,25.6 Q50,27 47.35,28.4 L35.65,34.6 Q33,36 33,33 V21 Q33,18 35.65,19.4 Z</Geometry>
  <Geometry x:Key="LogoGloss">M0,14 A14,14 0 0 1 14,0 H50 A14,14 0 0 1 64,14 V27 Q32,40 0,27 Z</Geometry>
  <LinearGradientBrush x:Key="LogoGlossBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#38FFFFFF" />
    <GradientStop Offset="1" Color="#00FFFFFF" />
  </LinearGradientBrush>
  <Geometry x:Key="LogoMarkOrbit">M15,13 H23 V41 H47 V49 H15 Z M34,15 L49,25 L34,35 Z M47,39 A5,5 0 1 1 47,49 A5,5 0 1 1 47,39 Z</Geometry>
  <Geometry x:Key="LogoMarkMonogram">M17,13 H49 V21 H25 V29 H43 V37 H25 V49 H17 Z</Geometry>
</ResourceDictionary>
