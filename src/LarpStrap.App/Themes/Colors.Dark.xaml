<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Nebulosa, dark. Contrast is enforced by ThemeContrastTests (WCAG 2.x). Accent brushes are set by ThemeService.
    Layer brushes are translucent so the Mica/Acrylic window material shows through; cards stay opaque for legibility.
  -->
  <SolidColorBrush x:Key="BgBrush" Color="#0D1722" />
  <SolidColorBrush x:Key="LayerBrush" Color="#D90D1722" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#121F2A" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A2C39" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#223A49" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2D4655" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#9AA8BA" />
  <SolidColorBrush x:Key="TextBrush" Color="#E7EAF0" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#A9B1BE" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#858F9D" />
  <SolidColorBrush x:Key="OkBrush" Color="#69B889" />
  <SolidColorBrush x:Key="WarnBrush" Color="#D8A64D" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#DB8080" />
  <SolidColorBrush x:Key="InfoBrush" Color="#79AFC2" />
  <SolidColorBrush x:Key="OkSoftBrush" Color="#182A22" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="#302719" />
  <SolidColorBrush x:Key="ErrorSoftBrush" Color="#301D20" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#1A2931" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#CC05070B" />
</ResourceDictionary>
