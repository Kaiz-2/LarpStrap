<Window x:Class="LarpStrap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LarpStrap.App.ViewModels"
        xmlns:views="clr-namespace:LarpStrap.App.Views"
        Title="LarpStrap" Language="es-ES"
        Width="1380" Height="880" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource FontText}" FontSize="{StaticResource FontSizeBody}">
  <!-- The client area extends under the title bar; Windows keeps drawing the caption buttons. ThemeService sets the
       window material (Mica/Acrylic) or a solid background. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="60" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstancesViewModel}"><views:InstancesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><views:AccountsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShortcutsViewModel}"><views:ShortcutsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CustomizationViewModel}"><views:CustomizationView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FastFlagsViewModel}"><views:FastFlagsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>

    <DataTemplate x:Key="NavEntry">
      <RadioButton GroupName="Nav" Margin="0,0,0,4" Tag="{Binding Glyph}" Content="{Binding AccessKeyTitle}"
                   IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
        <RadioButton.Style>
          <Style TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.IsNavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Template" Value="{StaticResource NavItemCompactTemplate}" />
                <Setter Property="ToolTip" Value="{Binding Title}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </RadioButton.Style>
      </RadioButton>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.LayoutTransform>
      <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="60" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Title bar (draggable): logo, name, version and the demo badge. Caption buttons are drawn by Windows on the right. -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0,170,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <views:LogoBadge Width="28" Height="28" />
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource FontBrand}" FontSize="16" Text="LarpStrap" />
          <Border Margin="12,0,0,0" Padding="9,3" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" />
          </Border>
          <Border Style="{StaticResource SimulatedChip}" Margin="12,0,0,0" Visibility="{Binding IsSimulated, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Text="MODO DEMOSTRACIÓN · SIMULADO" />
          </Border>
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding Current.Title}" />
      </Grid>
    </Border>

    <!-- Navigation is grouped by task: play first, technical tools only in advanced mode, settings at the bottom. -->
    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="244" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsNavCompact}" Value="True"><Setter Property="Width" Value="76" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel Margin="14,18,14,14">
      <ToggleButton x:Name="NavToggle" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,18" IsChecked="{Binding IsNavCompact, Mode=TwoWay}">
        <ToggleButton.Style>
          <Style TargetType="ToggleButton" BasedOn="{StaticResource PaneToggle}">
            <Setter Property="AutomationProperties.Name" Value="Contraer la navegación" />
            <Setter Property="ToolTip" Value="Contraer la navegación" />
            <Style.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="AutomationProperties.Name" Value="Expandir la navegación" />
                <Setter Property="ToolTip" Value="Expandir la navegación" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </ToggleButton.Style>
      </ToggleButton>

      <!-- Bottom: appearance, settings, about, and simple/advanced. -->
      <StackPanel DockPanel.Dock="Bottom">
        <Border Height="1" Margin="8,8,8,12" Background="{DynamicResource BorderSubtleBrush}" />
        <ItemsControl ItemsSource="{Binding FooterPages}" ItemTemplate="{StaticResource NavEntry}" Focusable="False"
                      KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Configuración" />
        <CheckBox Style="{StaticResource ToggleCheck}" Margin="12,8,0,0" Content="Modo avan_zado" IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"
                  AutomationProperties.Name="Modo avanzado: muestra FastFlags, Diagnóstico y los detalles técnicos"
                  ToolTip="Muestra FastFlags, Diagnóstico y los detalles técnicos"
                  Visibility="{Binding IsNavCompact, Converter={StaticResource Hidden}}" />
        <ToggleButton Style="{StaticResource IconToggle}" Margin="0,8,0,0" HorizontalAlignment="Left" IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"
                      AutomationProperties.Name="Modo avanzado: muestra FastFlags, Diagnóstico y los detalles técnicos" ToolTip="Modo avanzado"
                      Visibility="{Binding IsNavCompact, Converter={StaticResource Visible}}">
          <views:Glyph Style="{StaticResource IconText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Text="&#xE90F;" />
        </ToggleButton>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
          <TextBlock Style="{StaticResource OverlineText}" Margin="12,4,0,8" Text="JUGAR" Visibility="{Binding IsNavCompact, Converter={StaticResource Hidden}}" />
          <ItemsControl ItemsSource="{Binding PlayPages}" ItemTemplate="{StaticResource NavEntry}" Focusable="False"
                        KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Jugar" />
          <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource OverlineText}" Margin="12,16,0,8" Text="AVANZADO" Visibility="{Binding IsNavCompact, Converter={StaticResource Hidden}}" />
            <Border Height="1" Margin="8,12,8,12" Background="{DynamicResource BorderSubtleBrush}" Visibility="{Binding IsNavCompact, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding AdvancedPages}" ItemTemplate="{StaticResource NavEntry}" Focusable="False"
                          KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Avanzado" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Page workspace and persistent status line. -->
    <Border Grid.Row="1" Grid.Column="1" Margin="0" Background="{DynamicResource LayerBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="PageHost" Content="{Binding Current.Page}" Focusable="False" />
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,10">
          <StackPanel Orientation="Horizontal">
            <views:Glyph FontSize="12" Margin="0,0,8,0" Text="&#xE789;">
              <views:Glyph.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </views:Glyph.Style>
            </views:Glyph>
            <TextBlock x:Name="LiveStatus" Style="{StaticResource CaptionText}" Text="{Binding StatusMessage}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding StatusMessage}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Persistent, visible notice. The footer remains the accessible live region; this banner makes updates hard to miss. -->
    <Border Grid.Row="1" Grid.Column="1" Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top"
            Width="450" Margin="20,18,24,0" Padding="16,14" CornerRadius="14"
            Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1"
            Visibility="{Binding HasStatusMessage, Converter={StaticResource Visible}}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Top">
          <views:Glyph Style="{StaticResource IconText}" HorizontalAlignment="Center" Foreground="{DynamicResource InfoBrush}" Text="&#xE946;" />
        </Border>
        <TextBlock Grid.Column="1" Margin="12,1,12,0" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextBrush}"
                   Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Button Grid.Column="2" Style="{StaticResource IconToggle}" Width="30" Height="30" Padding="0" Click="DismissStatus_Click"
                AutomationProperties.Name="Cerrar aviso" ToolTip="Cerrar aviso">
          <TextBlock FontSize="19" VerticalAlignment="Center" Text="×" />
        </Button>
      </Grid>
    </Border>

    <!-- Launch dialog: shown while a launch runs, wherever it was started. Focus moves to Cancel (code-behind). -->
    <Grid x:Name="LaunchOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
          Visibility="{Binding Launcher.IsLaunching, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
          AutomationProperties.Name="Lanzando Roblox" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="420" Style="{StaticResource HeroCard}" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" Foreground="{DynamicResource OnBrandMutedBrush}"
                       FontFamily="{StaticResource FontMono}" Text="{Binding Launcher.InstallationDetail}" />
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource OnBrandMutedBrush}" Text="Roblox" />
          </DockPanel>
          <Grid Width="96" Height="96" Margin="0,28,0,0" HorizontalAlignment="Center">
            <Ellipse x:Name="Spinner" Stroke="{StaticResource OnBrandTrackBrush}" StrokeThickness="3" StrokeDashArray="18 12" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRotation" /></Ellipse.RenderTransform>
            </Ellipse>
            <views:LogoBadge OnBrand="True" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource FontBrand}" FontSize="22"
                     Foreground="{DynamicResource OnBrandBrush}" Text="Iniciando Roblox…" />
          <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource BodyText}"
                     Foreground="{DynamicResource OnBrandMutedBrush}" Text="Esperando a que aparezca la ventana del cliente." />
          <Border Style="{StaticResource Chip}" BorderThickness="1" Margin="0,12,0,0" HorizontalAlignment="Center" Background="{StaticResource OnBrandChipBrush}" BorderBrush="{DynamicResource OnBrandBrush}"
                  Visibility="{Binding Launcher.IsSimulated, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource OnBrandBrush}" FontWeight="SemiBold" Text="SIMULADO" />
          </Border>
          <Button x:Name="CancelLaunchButton" Style="{StaticResource HeroSecondaryButton}" Margin="0,24,0,0" HorizontalAlignment="Center"
                  Content="_Cancelar lanzamiento" Command="{Binding Launcher.CancelLaunchCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
