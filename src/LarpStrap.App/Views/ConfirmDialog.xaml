<Window x:Class="LarpStrap.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views"
        Language="es-ES" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource FontText}" FontSize="{StaticResource FontSizeBody}" MaxWidth="540">
  <StackPanel Margin="28,28,28,24" MinWidth="400">
    <DockPanel>
      <Border x:Name="IconTile" DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top">
        <views:Glyph x:Name="IconBlock" Style="{StaticResource IconText}" HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE897;" />
      </Border>
      <StackPanel>
        <TextBlock x:Name="TitleBlock" Style="{StaticResource TitleText}" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageBlock" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
      </StackPanel>
    </DockPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="ConfirmButton" Click="Confirm_Click" Margin="0,0,8,0" />
      <Button x:Name="CancelButton" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
