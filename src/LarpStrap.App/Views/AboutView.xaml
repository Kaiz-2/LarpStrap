<UserControl x:Class="LarpStrap.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,24,32,32" MaxWidth="1120">
      <TextBlock Style="{StaticResource DisplayText}" Text="Acerca de" />

      <Border Style="{StaticResource HeroCard}" Margin="0,20,0,0">
        <DockPanel>
          <views:LogoBadge DockPanel.Dock="Left" OnBrand="True" Width="80" Height="80" Margin="0,0,24,0" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Style="{StaticResource HeroText}" FontSize="34" Text="LarpStrap" />
            <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource OnBrandMutedBrush}" Text="{Binding Version, StringFormat='Versión {0}'}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Foreground="{DynamicResource OnBrandBrush}"
                       Text="Bootstrapper no oficial de Roblox para Windows. No está afiliado a Roblox Corporation ni respaldado por ella." />
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" Foreground="{DynamicResource OnBrandMutedBrush}" Text="Licencia MIT · © 2026 Leir" />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,12" Text="Principios" />
      <views:SettingCard Icon="&#xE72E;" Title="Sin credenciales" Description="No guarda contraseñas ni cookies, no lee la línea de comandos de Roblox y no registra enlaces de juego." />
      <views:SettingCard Icon="&#xE7BA;" Title="Clientes oficiales" Description="Abre Roblox - Windows y el navegador con sesiones separadas. No elude ni modifica las protecciones del cliente." />
      <views:SettingCard Icon="&#xE7FC;" Title="Lo simulado, siempre a la vista" Description="El modo demostración marca cada cliente simulado; nunca se mezclan con los reales." />

      <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,12" Text="Actualizaciones" />
      <views:SettingCard Icon="&#xE895;" Title="Buscar actualizaciones"
                         Description="Aún no disponible. LarpStrap solo comprobará si hay una versión nueva y te enlazará su descarga: nunca se actualizará solo.">
        <Button Content="No disponible todavía" IsEnabled="False" />
      </views:SettingCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
