<UserControl x:Class="LarpStrap.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="DashboardGlow" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#24232F" Offset="0" />
      <GradientStop Color="#19191F" Offset="0.58" />
      <GradientStop Color="#20212A" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="38,28,38,38" MaxWidth="1180">
      <Grid>
        <StackPanel>
          <TextBlock Style="{StaticResource OverlineText}" Foreground="{DynamicResource AccentTextBrush}" Text="LARPSTRAP  /  CENTRO DE JUEGO" />
          <TextBlock Style="{StaticResource DisplayText}" Margin="0,5,0,0" FontSize="34" Text="Tu próxima partida empieza aquí" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0" Text="Roblox, tus juegos y tus ajustes en un solo sitio." />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Chip}" Background="{DynamicResource OkSoftBrush}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center" />
            <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="LARPSTRAP LISTO" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Margin="0,24,0,0" Height="296" CornerRadius="12" Background="{StaticResource DashboardGlow}" ClipToBounds="True" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.24" BlurRadius="28" ShadowDepth="5" Direction="270" /></Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
          <Ellipse Grid.Column="1" Width="310" Height="310" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Fill="#191920" Stroke="#393944" StrokeThickness="1" Opacity="0.75" />
          <Ellipse Grid.Column="1" Width="252" Height="252" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0"
                   Fill="Transparent" Stroke="#454552" StrokeThickness="1" Opacity="0.68" />
          <Ellipse Grid.Column="1" Width="194" Height="194" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,57,0"
                   Fill="#22222B" Stroke="#555563" StrokeThickness="1" Opacity="0.9" />
          <Border Grid.Column="1" Width="132" Height="132" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,88,0"
                  CornerRadius="66" Background="#282832" BorderBrush="#666675" BorderThickness="1">
            <views:LogoBadge OnBrand="True" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border Grid.Column="1" Width="172" Height="54" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,22"
                  Background="#E622222B" BorderBrush="#555563" BorderThickness="1" CornerRadius="8">
            <StackPanel Margin="13,0" VerticalAlignment="Center">
              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#AFC2D1" Text="INSTALACIÓN" />
              <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#F2F6FA" Text="{Binding Instances.InstallationText}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="0" Margin="32,28,8,28" VerticalAlignment="Center" MaxWidth="540">
              <Border HorizontalAlignment="Left" Padding="10,5" CornerRadius="7" Background="#292933" BorderBrush="#555563" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#72D59B" VerticalAlignment="Center" />
                <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#D9E8EF" Text="ESTADO DEL CLIENTE" />
              </StackPanel>
            </Border>
            <TextBlock Margin="0,15,0,0" FontFamily="{StaticResource FontDisplay}" FontSize="30" FontWeight="Bold"
                       Foreground="#F4F7FB" Text="{Binding Instances.StatusHeadline}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,18,0" FontSize="14" LineHeight="21" Foreground="#C0D0DC"
                       Text="{Binding Instances.LaunchHint}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button Style="{StaticResource HeroButton}" MinWidth="178" Command="{Binding Instances.LaunchCommand}"
                      AutomationProperties.Name="{Binding Instances.PrimaryActionText}">
                <StackPanel Orientation="Horizontal">
                  <views:Glyph Style="{StaticResource IconText}" Foreground="{StaticResource OnHeroButtonBrush}" Margin="0,0,10,0" Text="&#xE768;" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Instances.PrimaryActionText}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HeroSecondaryButton}" Margin="10,0,0,0" Content="Clientes abiertos"
                      Command="{Binding OpenPanelCommand}" AutomationProperties.Name="Ver los clientes abiertos" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <UniformGrid Columns="3" Margin="0,16,0,0">
        <Border Style="{StaticResource MetricCard}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
              <views:Glyph Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" Text="&#xE7FC;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CaptionText}" Text="CLIENTES ACTIVOS" />
              <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding Instances.Items.Count}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
              <views:Glyph Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" Text="&#xE734;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CaptionText}" Text="JUEGOS GUARDADOS" />
              <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding Shortcuts.Favorites.Count}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource MetricCard}" Margin="0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
              <views:Glyph Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" Text="&#xE790;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,8,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CaptionText}" Text="TU EXPERIENCIA" />
              <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="Personaliza el launcher" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding OpenCustomizationCommand}"
                    AutomationProperties.Name="Abrir personalización" ToolTip="Personalización">
              <views:Glyph Style="{StaticResource IconText}" Text="&#xE8A7;" />
            </Button>
          </Grid>
        </Border>
      </UniformGrid>

      <DockPanel Margin="2,30,2,14">
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenShortcutsCommand}"
                AutomationProperties.Name="Añadir o gestionar juegos">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource IconText}" Margin="0,0,8,0" Text="&#xE710;" />
            <AccessText VerticalAlignment="Center" Text="_Añadir juego" />
          </StackPanel>
        </Button>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource TitleText}" Text="Tu biblioteca" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0" Text="Tus experiencias favoritas, listas para abrir." />
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding Shortcuts.IsEmpty, Converter={StaticResource Visible}}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="58" Height="58" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
            <views:Glyph Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Center"
                         Foreground="{DynamicResource AccentTextBrush}" Text="&#xE734;" />
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SubtitleText}" FontSize="16" Text="Empieza tu biblioteca" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0" Text="Añade un enlace o un Place ID y tendrás tus juegos a un clic." />
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Content="Añadir experiencia"
                  Command="{Binding OpenShortcutsCommand}" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Shortcuts.Favorites}" Focusable="False" AutomationProperties.Name="Tus juegos">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource GameTile}" Width="264" Margin="0,0,14,14" Click="OpenJoinMenu"
                    AutomationProperties.Name="{Binding OpenName}" ToolTip="{Binding PlaceText}">
              <StackPanel>
                <Border Width="234" Height="132" HorizontalAlignment="Center" Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="{StaticResource RadiusContainer}" ClipToBounds="True">
                  <Grid>
                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" Visibility="{Binding HasThumbnail, Converter={StaticResource Visible}}" />
                    <views:Glyph Style="{StaticResource IconText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"
                                 Foreground="{DynamicResource AccentTextBrush}" Text="&#xE7FC;"
                                 Visibility="{Binding HasThumbnail, Converter={StaticResource Hidden}}" />
                  </Grid>
                </Border>
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,14,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextBrush}" Text="Jugar ahora" />
                  <views:Glyph Style="{StaticResource IconText}" FontSize="10" Margin="6,0,0,0" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE8A7;" />
                </StackPanel>
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Unirme por Web" Command="{Binding JoinWebCommand}" />
                  <MenuItem Header="Unirme por Microsoft" Command="{Binding JoinMicrosoftCommand}" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
