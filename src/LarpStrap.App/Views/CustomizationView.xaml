<UserControl x:Class="LarpStrap.App.Views.CustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views">
  <UserControl.Resources>
    <!-- Mini window preview inside a theme tile; its fixed colours live in Themes/Accents.xaml (Preview*). -->
    <Style x:Key="PreviewFrame" TargetType="Border">
      <Setter Property="Height" Value="72" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="36,28,36,36" MaxWidth="1160">
      <TextBlock Style="{StaticResource DisplayText}" Text="Personalización" />
      <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Elige cómo se ve LarpStrap. Los cambios se aplican al momento y se guardan." />

      <!-- Appearance mode -->
      <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,12" Text="Modo de iluminación" />
      <WrapPanel KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Modo de iluminación">
        <RadioButton Style="{StaticResource TileOption}" GroupName="Theme" AutomationProperties.Name="Sistema"
                     IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=System}">
          <StackPanel>
            <Border Style="{StaticResource PreviewFrame}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PreviewLightBrush}" />
                <Border Grid.Column="1" Background="{StaticResource PreviewDarkBrush}" />
              </Grid>
            </Border>
            <TextBlock Text="Sistema" />
            <TextBlock Style="{StaticResource CaptionText}" Text="Sigue a Windows" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="Theme" AutomationProperties.Name="Claro"
                     IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Light}">
          <StackPanel>
            <Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PreviewLightBrush}">
              <Border Margin="12,12,40,12" CornerRadius="4" Background="{StaticResource PreviewLightCardBrush}" />
            </Border>
            <TextBlock Text="Claro" />
            <TextBlock Style="{StaticResource CaptionText}" Text="Fondo luminoso" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="Theme" AutomationProperties.Name="Oscuro"
                     IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Dark}">
          <StackPanel>
            <Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PreviewDarkBrush}">
              <Border Margin="12,12,40,12" CornerRadius="4" Background="{StaticResource PreviewDarkCardBrush}" />
            </Border>
            <TextBlock Text="Oscuro" />
            <TextBlock Style="{StaticResource CaptionText}" Text="Nebulosa nocturna" />
          </StackPanel>
        </RadioButton>
      </WrapPanel>

      <TextBlock Style="{StaticResource TitleText}" Margin="0,12,0,12" Text="Temas de interfaz" />
      <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10" Text="Cada tema cambia los fondos, superficies y bordes. El modo claro u oscuro se conserva por separado." />
      <WrapPanel KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Temas de interfaz">
        <RadioButton Style="{StaticResource TileOption}" GroupName="ThemePreset" AutomationProperties.Name="Nebulosa" IsChecked="{Binding ThemePreset, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Nebula}">
          <StackPanel><Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PresetNebulaDarkBgBrush}"><Grid><Border Margin="12,13,48,13" CornerRadius="4" Background="{StaticResource PresetNebulaDarkSurfaceAltBrush}" /><Border Width="28" Height="4" Margin="14,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SwatchViolet}" /></Grid></Border><TextBlock Text="Nebulosa"/><TextBlock Style="{StaticResource CaptionText}" Text="Azul petróleo y grafito"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="ThemePreset" AutomationProperties.Name="Medianoche" IsChecked="{Binding ThemePreset, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Midnight}">
          <StackPanel><Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PresetMidnightDarkBgBrush}"><Grid><Border Margin="12,13,48,13" CornerRadius="4" Background="{StaticResource PresetMidnightDarkSurfaceAltBrush}" /><Border Width="28" Height="4" Margin="14,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SwatchBlue}" /></Grid></Border><TextBlock Text="Medianoche"/><TextBlock Style="{StaticResource CaptionText}" Text="Azul profundo"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="ThemePreset" AutomationProperties.Name="Océano" IsChecked="{Binding ThemePreset, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Ocean}">
          <StackPanel><Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PresetOceanDarkBgBrush}"><Grid><Border Margin="12,13,48,13" CornerRadius="4" Background="{StaticResource PresetOceanDarkSurfaceAltBrush}" /><Border Width="28" Height="4" Margin="14,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SwatchCyan}" /></Grid></Border><TextBlock Text="Océano"/><TextBlock Style="{StaticResource CaptionText}" Text="Azul petróleo"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="ThemePreset" AutomationProperties.Name="Bosque" IsChecked="{Binding ThemePreset, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Forest}">
          <StackPanel><Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PresetForestDarkBgBrush}"><Grid><Border Margin="12,13,48,13" CornerRadius="4" Background="{StaticResource PresetForestDarkSurfaceAltBrush}" /><Border Width="28" Height="4" Margin="14,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SwatchMint}" /></Grid></Border><TextBlock Text="Bosque"/><TextBlock Style="{StaticResource CaptionText}" Text="Verde natural"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="ThemePreset" AutomationProperties.Name="Atardecer" IsChecked="{Binding ThemePreset, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Sunset}">
          <StackPanel><Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PresetSunsetDarkBgBrush}"><Grid><Border Margin="12,13,48,13" CornerRadius="4" Background="{StaticResource PresetSunsetDarkSurfaceAltBrush}" /><Border Width="28" Height="4" Margin="14,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SwatchOrange}" /></Grid></Border><TextBlock Text="Atardecer"/><TextBlock Style="{StaticResource CaptionText}" Text="Cobre y naranja"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="ThemePreset" AutomationProperties.Name="Rosa" IsChecked="{Binding ThemePreset, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Rose}">
          <StackPanel><Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PresetRoseDarkBgBrush}"><Grid><Border Margin="12,13,48,13" CornerRadius="4" Background="{StaticResource PresetRoseDarkSurfaceAltBrush}" /><Border Width="28" Height="4" Margin="14,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SwatchPink}" /></Grid></Border><TextBlock Text="Rosa"/><TextBlock Style="{StaticResource CaptionText}" Text="Ciruela y rosa"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="ThemePreset" AutomationProperties.Name="Pizarra" IsChecked="{Binding ThemePreset, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Slate}">
          <StackPanel><Border Style="{StaticResource PreviewFrame}" Background="{StaticResource PresetSlateDarkBgBrush}"><Grid><Border Margin="12,13,48,13" CornerRadius="4" Background="{StaticResource PresetSlateDarkSurfaceAltBrush}" /><Border Width="28" Height="4" Margin="14,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SwatchSlate}" /></Grid></Border><TextBlock Text="Pizarra"/><TextBlock Style="{StaticResource CaptionText}" Text="Gris azulado"/></StackPanel>
        </RadioButton>
      </WrapPanel>

      <!-- Accent -->
      <TextBlock Style="{StaticResource TitleText}" Margin="0,16,0,12" Text="Color de acento" />
      <Border Style="{StaticResource Card}">
        <WrapPanel KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Color de acento">
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchViolet}" Content="Violeta" AutomationProperties.Name="Violeta"
                       IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Violet}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchBlue}" Content="Azul" AutomationProperties.Name="Azul"
                       IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Blue}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchRose}" Content="Rosa" AutomationProperties.Name="Rosa"
                       IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Rose}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchTeal}" Content="Turquesa" AutomationProperties.Name="Turquesa"
                       IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Teal}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchCoral}" Content="Coral" AutomationProperties.Name="Coral"
                       IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Coral}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchLime}" Content="Lima" AutomationProperties.Name="Lima"
                       IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Lime}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchAmber}" Content="Ámbar" AutomationProperties.Name="Ámbar"
                       IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Amber}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchCyan}" Content="Cian" AutomationProperties.Name="Cian" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Cyan}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchMint}" Content="Menta" AutomationProperties.Name="Menta" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Mint}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchEmerald}" Content="Esmeralda" AutomationProperties.Name="Esmeralda" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Emerald}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchForest}" Content="Bosque" AutomationProperties.Name="Bosque" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Forest}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchSky}" Content="Cielo" AutomationProperties.Name="Cielo" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Sky}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchOcean}" Content="Océano" AutomationProperties.Name="Océano" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Ocean}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchIndigo}" Content="Índigo" AutomationProperties.Name="Índigo" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Indigo}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchLavender}" Content="Lavanda" AutomationProperties.Name="Lavanda" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Lavender}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchMagenta}" Content="Magenta" AutomationProperties.Name="Magenta" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Magenta}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchPink}" Content="Chicle" AutomationProperties.Name="Chicle" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Pink}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchCrimson}" Content="Carmesí" AutomationProperties.Name="Carmesí" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Crimson}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchOrange}" Content="Naranja" AutomationProperties.Name="Naranja" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Orange}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchGold}" Content="Dorado" AutomationProperties.Name="Dorado" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Gold}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchBronze}" Content="Bronce" AutomationProperties.Name="Bronce" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Bronze}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchSlate}" Content="Pizarra" AutomationProperties.Name="Pizarra" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Slate}" />
          <RadioButton Style="{StaticResource SwatchOption}" GroupName="Accent" Tag="{StaticResource SwatchGraphite}" Content="Grafito" AutomationProperties.Name="Grafito" IsChecked="{Binding Accent, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Graphite}" />
        </WrapPanel>
      </Border>
      <views:SettingCard Icon="&#xE790;" Title="Color propio"
                         Description="Introduce cualquier color en hexadecimal. LarpStrap ajusta los tonos del tema para conservar el contraste.">
        <StackPanel Orientation="Horizontal">
          <TextBox Width="150" MaxLength="7" Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Color hexadecimal personalizado" />
          <TextBlock Style="{StaticResource BodyText}" Margin="12,8,0,0" Text="#RRGGBB" />
          <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource ErrorBrush}" Margin="12,8,0,0" Text="{Binding CustomAccentHexError}" />
        </StackPanel>
      </views:SettingCard>

      <!-- Logo -->
      <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,12" Text="Logotipo" />
      <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" Text="Elige el símbolo que aparece dentro de LarpStrap. El icono del instalador y de Windows mantiene el diseño clásico." />
      <WrapPanel KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Logotipo">
        <RadioButton Style="{StaticResource TileOption}" GroupName="Logo" AutomationProperties.Name="Clásico"
                     IsChecked="{Binding Logo, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Classic}">
          <StackPanel>
            <Border Style="{StaticResource PreviewFrame}" Background="{StaticResource BrandGradientBrush}" Height="64">
              <Viewbox Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource LogoMark}" Fill="White" /></Viewbox>
            </Border>
            <TextBlock Text="Clásico" /><TextBlock Style="{StaticResource CaptionText}" Text="L + reproducir" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="Logo" AutomationProperties.Name="Órbita"
                     IsChecked="{Binding Logo, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Orbit}">
          <StackPanel>
            <Border Style="{StaticResource PreviewFrame}" Background="{StaticResource BrandGradientBrush}" Height="64">
              <Viewbox Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource LogoMarkOrbit}" Fill="White" /></Viewbox>
            </Border>
            <TextBlock Text="Órbita" /><TextBlock Style="{StaticResource CaptionText}" Text="Marca con satélite" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource TileOption}" GroupName="Logo" AutomationProperties.Name="Monograma"
                     IsChecked="{Binding Logo, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Monogram}">
          <StackPanel>
            <Border Style="{StaticResource PreviewFrame}" Background="{StaticResource BrandGradientBrush}" Height="64">
              <Viewbox Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource LogoMarkMonogram}" Fill="White" /></Viewbox>
            </Border>
            <TextBlock Text="Monograma" /><TextBlock Style="{StaticResource CaptionText}" Text="L geométrica" />
          </StackPanel>
        </RadioButton>
      </WrapPanel>

      <!-- Window and text -->
      <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,12" Text="Ventana y texto" />
      <views:SettingCard Icon="&#xE7F4;" Title="Material de la ventana"
                         Description="Mica y Acrílico dejan ver el fondo de escritorio difuminado (Windows 11 22H2 o posterior).">
        <StackPanel>
          <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Material de la ventana">
            <RadioButton Style="{StaticResource OptionButton}" GroupName="Backdrop" Content="Mica" IsEnabled="{Binding MaterialSupported}"
                         IsChecked="{Binding Backdrop, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Mica}" />
            <RadioButton Style="{StaticResource OptionButton}" GroupName="Backdrop" Content="Acrílico" IsEnabled="{Binding MaterialSupported}"
                         IsChecked="{Binding Backdrop, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Acrylic}" />
            <RadioButton Style="{StaticResource OptionButton}" GroupName="Backdrop" Content="Sólido"
                         IsChecked="{Binding Backdrop, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Solid}" />
          </StackPanel>
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="Tu versión de Windows no admite Mica ni Acrílico: se usa el fondo sólido."
                     Visibility="{Binding MaterialSupported, Converter={StaticResource Hidden}}" />
        </StackPanel>
      </views:SettingCard>
      <views:SettingCard Icon="&#xE8D2;" Title="Tamaño del texto"
                         Description="Amplía toda la interfaz de LarpStrap. Se suma al escalado de pantalla de Windows.">
        <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Tamaño del texto">
          <RadioButton Style="{StaticResource OptionButton}" GroupName="Scale" Content="100 %"
                       IsChecked="{Binding TextScale, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=1}" />
          <RadioButton Style="{StaticResource OptionButton}" GroupName="Scale" Content="115 %"
                       IsChecked="{Binding TextScale, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=1.15}" />
          <RadioButton Style="{StaticResource OptionButton}" GroupName="Scale" Content="130 %"
                       IsChecked="{Binding TextScale, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=1.3}" />
          <RadioButton Style="{StaticResource OptionButton}" GroupName="Scale" Content="150 %"
                       IsChecked="{Binding TextScale, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=1.5}" />
        </StackPanel>
      </views:SettingCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
