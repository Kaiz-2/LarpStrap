<UserControl x:Class="LarpStrap.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,24,32,32" MaxWidth="1120">
      <TextBlock Style="{StaticResource DisplayText}" Text="Dos cuentas" />
      <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Abre los dos clientes oficiales de Roblox: la app de Microsoft Store y la versión web." />

      <Border Style="{StaticResource Banner}" Tag="Info" Margin="0,20,0,0">
        <DockPanel>
          <views:Glyph DockPanel.Dock="Left" Style="{StaticResource IconText}" Foreground="{DynamicResource InfoBrush}" FontSize="18" Margin="0,0,12,0" Text="&#xE946;" />
          <StackPanel>
            <TextBlock Style="{StaticResource SubtitleText}" Text="Sesiones separadas, sin guardar credenciales" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,2,0,0" Text="La app y el navegador conservan sus propias sesiones. LarpStrap no accede a tus contraseñas ni cookies." />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,12" Text="Pasos" />
      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
          <StackPanel>
            <Border Style="{StaticResource Avatar}" HorizontalAlignment="Left">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Text="1" />
            </Border>
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,12,0,0" Text="Abre Roblox - Windows" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Inicia sesión con la primera cuenta en la app oficial de Microsoft Store." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="4,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource Avatar}" HorizontalAlignment="Left">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Text="2" />
            </Border>
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,12,0,0" Text="Abre Roblox en la web" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Inicia sesión con la segunda cuenta en tu navegador y pulsa Jugar en el juego." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <WrapPanel Margin="0,20,0,0">
        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Command="{Binding OpenRobloxWindowsCommand}"
                IsEnabled="{Binding IsOpeningStore, Converter={StaticResource Equals}, ConverterParameter=False}" AutomationProperties.Name="Abrir Roblox - Windows">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource IconText}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0" Text="&#xE8A7;" />
            <TextBlock VerticalAlignment="Center" Text="1 · Abrir Roblox - Windows" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Command="{Binding OpenRobloxWebCommand}" AutomationProperties.Name="Abrir Roblox en el navegador">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource IconText}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0" Text="&#xE774;" />
            <TextBlock VerticalAlignment="Center" Text="2 · Abrir Roblox en la web" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <Border Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding StatusText}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="Roblox puede cerrar una sesión al abrir la otra. Si ocurre, esta combinación no es compatible con la versión instalada." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
