<UserControl x:Class="LarpStrap.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="36,28,36,36" MaxWidth="1160">

      <!-- Header: title and freshness, then the actions in their own row (they wrap instead of squeezing the title). -->
      <StackPanel>
        <TextBlock Style="{StaticResource DisplayText}" Text="Clientes abiertos" />
        <WrapPanel Margin="0,4,0,0">
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,12,0" Text="{Binding SummaryText}" />
          <views:Glyph Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,0,6,0" Text="&#xE7BA;"
                       Visibility="{Binding IsStale, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{Binding RefreshText}" />
        </WrapPanel>
      </StackPanel>
      <WrapPanel Margin="0,16,0,0">
        <Button Style="{StaticResource PrimaryButton}" MinHeight="{StaticResource ControlHeightLarge}" Margin="0,0,0,8" Command="{Binding LaunchCommand}"
                AutomationProperties.Name="{Binding PrimaryActionText}">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource IconText}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,12,0" Text="&#xE768;" />
            <TextBlock VerticalAlignment="Center" Text="{Binding PrimaryActionText}" />
          </StackPanel>
        </Button>
        <Button MinHeight="{StaticResource ControlHeightLarge}" Margin="8,0,0,8" Content="Cancelar lanzamiento" Command="{Binding CancelLaunchCommand}"
                Visibility="{Binding IsLaunching, Converter={StaticResource Visible}}" />
      </WrapPanel>
      <DockPanel Margin="0,4,0,0">
        <views:Glyph DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="14" Margin="0,2,8,0" VerticalAlignment="Top" Text="&#xE946;" />
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding LaunchHint}" />
      </DockPanel>

      <!-- One compact demo notice here; the title bar chip and each row's SIMULADO chip keep it visible elsewhere. -->
      <Border Style="{StaticResource Banner}" Tag="Info" Margin="0,16,0,0" Padding="12,8" Visibility="{Binding IsSimulated, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource BodyText}" Text="Datos SIMULADOS: ninguno de estos clientes es un proceso real de Roblox. Desactívalo en Ajustes." />
      </Border>

      <!-- Latest result stays visible so a failure is never only below the fold. -->
      <Border Style="{StaticResource Banner}" Tag="{Binding LastActivity.KindName}" Margin="0,12,0,0" Padding="12,8"
              Visibility="{Binding HasActivity, Converter={StaticResource Visible}}">
        <StackPanel>
          <WrapPanel>
            <TextBlock Style="{StaticResource MonoText}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding LastActivity.TimeText}" Margin="0,0,12,0" />
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding LastActivity.Summary}" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="8,2,0,0" Text="· simulado" Visibility="{Binding LastActivity.IsSimulated, Converter={StaticResource Visible}}" />
          </WrapPanel>
          <TextBlock Style="{StaticResource BodyText}" Margin="0,2,0,0" Text="{Binding LastActivity.Guidance}" />
        </StackPanel>
      </Border>

      <!-- Clients: one compact row each. Technical data (PID, memory, origin) sits in «Detalles»; Forzar cierre in «⋯» and the context menu. -->
      <TextBlock Style="{StaticResource OverlineText}" Text="CLIENTES" Margin="0,24,0,8" />
      <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
        <DockPanel>
          <views:Glyph DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="20" Margin="0,0,16,0" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE7FC;" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SubtitleText}" FontSize="{StaticResource FontSizeBody}" Text="No hay ningún cliente de Roblox abierto." />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="Pulsa Lanzar para abrir Roblox, o entra a un juego desde el navegador." />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="4" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
        <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.Name="Clientes de Roblox" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border MinHeight="{StaticResource RowHeight}" Padding="12,8" CornerRadius="{StaticResource RadiusControl}" AutomationProperties.Name="{Binding AccessibleSummary}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <!-- Right-click or Shift+F10 on a row: the same actions, Forzar cierre included. -->
                    <Setter Property="ContextMenu">
                      <Setter.Value>
                        <ContextMenu>
                          <MenuItem Header="_Enfocar" Command="{Binding FocusCommand}" AutomationProperties.Name="{Binding FocusName}"
                                    Visibility="{Binding CanAct, Converter={StaticResource Visible}}" />
                          <MenuItem Header="_Cerrar" Command="{Binding CloseCommand}" AutomationProperties.Name="{Binding CloseName}"
                                    Visibility="{Binding CanAct, Converter={StaticResource Visible}}" />
                          <MenuItem Header="_Forzar cierre…" Foreground="{DynamicResource ErrorBrush}" Command="{Binding ForceKillCommand}"
                                    AutomationProperties.Name="{Binding KillName}" Visibility="{Binding CanForceKill, Converter={StaticResource Visible}}" />
                        </ContextMenu>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger>
                      <!-- The background (tray) process is read-only: no menu at all. -->
                      <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="ContextMenu" Value="{x:Null}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="Enfocar" Margin="0,0,8,0" Command="{Binding FocusCommand}" AutomationProperties.Name="{Binding FocusName}"
                            Visibility="{Binding CanAct, Converter={StaticResource Visible}}" />
                    <Button Content="Cerrar" Command="{Binding CloseCommand}" AutomationProperties.Name="{Binding CloseName}"
                            Visibility="{Binding CanAct, Converter={StaticResource Visible}}" />
                    <Menu Style="{StaticResource MoreMenu}" Margin="4,0,0,0" Visibility="{Binding CanForceKill, Converter={StaticResource Visible}}">
                      <MenuItem AutomationProperties.Name="{Binding Pid, StringFormat='Más acciones del cliente {0}'}" ToolTip="Más acciones">
                        <MenuItem.Header>
                          <views:Glyph Style="{StaticResource IconText}" Foreground="{DynamicResource TextBrush}" Text="&#xE712;" />
                        </MenuItem.Header>
                        <MenuItem Header="_Forzar cierre…" Foreground="{DynamicResource ErrorBrush}" Command="{Binding ForceKillCommand}"
                                  AutomationProperties.Name="{Binding KillName}" />
                      </MenuItem>
                    </Menu>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ReadOnlyText}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}">
                      <views:Glyph Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" Text="&#xE72E;" />
                      <TextBlock Style="{StaticResource CaptionText}" Text="Solo lectura" />
                    </StackPanel>
                  </StackPanel>
                  <ContentPresenter DockPanel.Dock="Left" Width="148" Margin="0,6,12,0" VerticalAlignment="Top" Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" />
                  <StackPanel VerticalAlignment="Center">
                    <WrapPanel>
                      <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,8,0" Text="Roblox" />
                      <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding SinceText}" />
                      <Border Style="{StaticResource SimulatedChip}" Padding="8,1" Visibility="{Binding IsSimulated, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Text="SIMULADO" />
                      </Border>
                    </WrapPanel>
                    <Expander Style="{StaticResource DetailsExpander}" Header="Detalles" Margin="0,2,0,0" IsExpanded="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                              AutomationProperties.Name="{Binding Pid, StringFormat='Detalles del cliente {0}'}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" FontFamily="{StaticResource FontMono}" Text="{Binding PidText}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding MemoryText, StringFormat='Memoria: {0}'}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OriginText, StringFormat='Origen: {0}'}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ReadOnlyText}" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Activity: folded by default; the latest result is already shown above. -->
      <Expander Style="{StaticResource DetailsExpander}" Margin="0,24,0,0" AutomationProperties.Name="Actividad" IsExpanded="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
        <Expander.Header>
          <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding Activity.Count, StringFormat='Actividad ({0})'}" />
        </Expander.Header>
        <StackPanel Margin="0,8,0,0">
          <TextBlock Style="{StaticResource MutedText}" Text="Todavía no hay actividad en esta sesión."
                     Visibility="{Binding HasActivity, Converter={StaticResource Hidden}}" />
          <ItemsControl ItemsSource="{Binding Activity}" AutomationProperties.Name="Actividad" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,12">
                  <Grid DockPanel.Dock="Left" Width="20" Margin="0,4,12,0">
                    <Ellipse x:Name="Dot" Width="10" Height="10" VerticalAlignment="Top" Fill="{DynamicResource BorderStrongBrush}" />
                  </Grid>
                  <StackPanel>
                    <WrapPanel>
                      <TextBlock Style="{StaticResource MonoText}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding TimeText}" Margin="0,0,12,0" />
                      <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Summary}" />
                      <TextBlock Style="{StaticResource CaptionText}" Margin="8,2,0,0" Text="· simulado" Visibility="{Binding IsSimulated, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="{Binding Guidance}"
                               Visibility="{Binding HasGuidance, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" FontFamily="{StaticResource FontMono}"
                               Text="{Binding Diagnostic, StringFormat='Detalle: {0}'}" TextWrapping="Wrap"
                               Visibility="{Binding HasDiagnostic, Converter={StaticResource Visible}}" />
                  </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="Ok"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OkBrush}" /></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Warn"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Info"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource InfoBrush}" /></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
