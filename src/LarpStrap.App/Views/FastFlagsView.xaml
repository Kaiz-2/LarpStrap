<UserControl x:Class="LarpStrap.App.Views.FastFlagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="36,28,36,36" MaxWidth="1160">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="16,0,0,0" Command="{Binding ResetAllCommand}" Content="Restablecer _todo" />
        <StackPanel>
          <TextBlock Style="{StaticResource DisplayText}" Text="FastFlags" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding SummaryText}" />
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource Banner}" Tag="Info" Margin="0,20,0,0">
        <DockPanel>
          <views:Glyph DockPanel.Dock="Left" Style="{StaticResource IconText}" Foreground="{DynamicResource InfoBrush}" FontSize="18" Margin="0,0,12,0" Text="&#xE946;" />
          <StackPanel>
            <TextBlock Style="{StaticResource SubtitleText}" Text="Solo los flags que Roblox permite" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,2,0,0"
                       Text="Desde el 29-09-2025 Roblox ignora cualquier otro flag. Esta es su lista oficial, y puede cambiarla sin aviso. LarpStrap escribe tus cambios en la versión de Roblox que lanza, justo antes de abrirla; si abres Roblox con otro programa, este puede sustituirlos. En el modo demostración no se escribe nada." />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
        <StackPanel>
          <TextBlock Style="{StaticResource SubtitleText}" Text="Buscar y filtrar" />
          <DockPanel Margin="0,10,0,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Buscar por nombre, descripción o clave" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" MaxWidth="420"
                     AutomationProperties.Name="Buscar FastFlags" />
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <CheckBox Style="{StaticResource ToggleCheck}" Content="Mostrar solo los que he cambiado"
                      IsChecked="{Binding ShowConfiguredOnly, Mode=TwoWay}" AutomationProperties.Name="Mostrar solo FastFlags cambiados" />
            <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ResultsText}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20" Visibility="{Binding HasNoVisibleFlags, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SubtitleText}" Text="No hay flags que coincidan" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Prueba otra búsqueda o desactiva el filtro de cambios." />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding VisibleFlags}" Focusable="False" Margin="0,20,0,0" AutomationProperties.Name="FastFlags">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:SettingCard Icon="&#xE9E9;" Title="{Binding Info.Title}" Description="{Binding Info.Description}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="{Binding Info.Title}"
                            Visibility="{Binding IsBool, Converter={StaticResource Visible}}">
                  <RadioButton Style="{StaticResource OptionButton}" GroupName="{Binding Info.Name}" Content="Roblox"
                               AutomationProperties.Name="Valor de Roblox"
                               IsChecked="{Binding Choice, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Default}" />
                  <RadioButton Style="{StaticResource OptionButton}" GroupName="{Binding Info.Name}" Content="Sí"
                               IsChecked="{Binding Choice, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=True}" />
                  <RadioButton Style="{StaticResource OptionButton}" GroupName="{Binding Info.Name}" Content="No"
                               IsChecked="{Binding Choice, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=False}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsBool, Converter={StaticResource Hidden}}">
                  <TextBox Width="140" HorizontalAlignment="Left" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                           AutomationProperties.Name="{Binding Info.Title}" AutomationProperties.HelpText="{Binding Hint}" />
                  <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Text="{Binding Hint}" />
                  <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left"
                             Foreground="{DynamicResource ErrorBrush}" Text="{Binding Error}" AutomationProperties.LiveSetting="Assertive"
                             Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource CaptionText}" FontFamily="{StaticResource FontMono}" Margin="0,8,0,0" Text="{Binding Info.Name}" />
              </StackPanel>
            </views:SettingCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
