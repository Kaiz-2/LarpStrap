<UserControl x:Class="LarpStrap.App.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,24,32,32" MaxWidth="1120">
      <TextBlock Style="{StaticResource OverlineText}" Foreground="{DynamicResource AccentTextBrush}" Text="TU BIBLIOTECA" />
      <TextBlock Style="{StaticResource DisplayText}" Margin="0,4,0,0" Text="Accesos directos" />
      <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" MaxWidth="720"
                 Text="Guarda tus experiencias favoritas y decide en cada momento si quieres abrirlas en Web o en Microsoft." />

      <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="24">
        <StackPanel>
          <DockPanel Margin="0,0,0,18">
            <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
              <views:Glyph Style="{StaticResource IconText}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE710;" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SubtitleText}" Text="Añadir una experiencia" />
              <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" Text="Pega su enlace o ID; el nombre y la portada se completan automáticamente." />
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.ColumnSpan="2">
              <Label x:Name="GameLabel" Target="{Binding ElementName=GameBox}" Padding="0,0,0,8" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                     Content="_Enlace o ID de Roblox" />
              <TextBox x:Name="GameBox" Text="{Binding NewGame, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.LabeledBy="{Binding ElementName=GameLabel}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
              <Label x:Name="NameLabel" Target="{Binding ElementName=NameBox}" Padding="0,0,0,8" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                     Content="_Nombre para mostrar" />
              <TextBox x:Name="NameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" />
              <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Text="Se rellena con el nombre oficial del juego. Puedes cambiarlo cuando quieras." />
            </StackPanel>
          </Grid>
          <Border Margin="0,16,0,0" Padding="14" CornerRadius="{StaticResource RadiusContainer}"
                  Background="{DynamicResource SurfaceAltBrush}" Visibility="{Binding HasPreview, Converter={StaticResource Visible}}">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Left" Width="128" Height="88" Margin="0,0,16,0" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding PreviewImageUrl}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Bottom" Height="26" Background="#99000000">
                    <TextBlock Style="{StaticResource CaptionText}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Text="VISTA PREVIA" />
                  </Border>
                </Grid>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding NewName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource CaptionText}" FontFamily="{StaticResource FontMono}" Text="{Binding PreviewPlaceText}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding LookupStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" MaxWidth="520" Text="Elige Web o Microsoft al unirte. Cada cliente conserva su propia cuenta." TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Style="{StaticResource PrimaryButton}" Click="OpenJoinMenu" IsDefault="True" AutomationProperties.Name="Elegir método para unirme">
                <StackPanel Orientation="Horizontal">
                  <views:Glyph Style="{StaticResource IconText}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0" Text="&#xE768;" />
                  <TextBlock VerticalAlignment="Center" Text="Unirme con ▾" />
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Unirme por Web" Command="{Binding JoinWebCommand}" />
                    <MenuItem Header="Unirme por Microsoft" Command="{Binding JoinMicrosoftCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Margin="8,0,0,0" Command="{Binding AddCommand}" AutomationProperties.Name="Guardar acceso directo">
                <StackPanel Orientation="Horizontal">
                  <views:Glyph Style="{StaticResource IconText}" Margin="0,0,8,0" Text="&#xE710;" />
                  <AccessText VerticalAlignment="Center" Text="_Guardar" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ValidationMessage}"
                     AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </Border>

      <DockPanel Margin="0,30,0,10">
        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="10,3">
          <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextBrush}" Text="{Binding Favorites.Count, StringFormat='{}{0} guardados'}" />
        </Border>
        <TextBlock Style="{StaticResource TitleText}" VerticalAlignment="Center" Text="Tu biblioteca" />
      </DockPanel>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
        <StackPanel HorizontalAlignment="Center" Margin="0,8">
          <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
            <views:Glyph Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE734;" />
          </Border>
          <TextBlock Style="{StaticResource SubtitleText}" Margin="0,14,0,0" HorizontalAlignment="Center" Text="Tu biblioteca empieza aquí" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextAlignment="Center" Text="Añade una experiencia arriba y aparecerá aquí con su portada." />
        </StackPanel>
      </Border>
      <!-- Compact rows: experience, join, and remove. -->
      <Border Style="{StaticResource Card}" Padding="4" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
        <ItemsControl ItemsSource="{Binding Favorites}" Focusable="False" AutomationProperties.Name="Tus juegos">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border MinHeight="{StaticResource RowHeight}" Padding="12,6" CornerRadius="{StaticResource RadiusControl}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OpenJoinMenu" AutomationProperties.Name="{Binding OpenName}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Unirme ▾" />
                        <views:Glyph Style="{StaticResource IconText}" FontSize="12" Margin="8,0,0,0" Text="&#xE8A7;" />
                      </StackPanel>
                      <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                          <MenuItem Header="Unirme por Web" Command="{Binding JoinWebCommand}" />
                          <MenuItem Header="Unirme por Microsoft" Command="{Binding JoinMicrosoftCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                            AutomationProperties.Name="{Binding RemoveName}" ToolTip="{Binding RemoveName}">
                      <views:Glyph Style="{StaticResource IconText}" Text="&#xE74D;" />
                    </Button>
                  </StackPanel>
                  <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="36" Height="36" Margin="0,0,12,0" ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" Visibility="{Binding HasThumbnail, Converter={StaticResource Visible}}" />
                      <views:Glyph Style="{StaticResource IconText}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE7FC;"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource Hidden}}" />
                    </Grid>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Style="{StaticResource CaptionText}" FontFamily="{StaticResource FontMono}" Text="{Binding PlaceText}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
