<Application x:Class="LarpStrap.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LarpStrap.App.Views"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Same order as the app: index 0 is replaced by ThemeService (light/dark). -->
        <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
        <ResourceDictionary Source="Themes/Tokens.xaml" />
        <ResourceDictionary Source="Themes/Accents.xaml" />
        <ResourceDictionary Source="Themes/Presets.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <views:BoolToVisibilityConverter x:Key="Visible" />
      <views:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
